# Copy to .env and adjust. Loaded by prisma.config.ts (via dotenv) and the app.
#
# Dev (SQLite): a local file. A relative path resolves from the project root.
# If your process runs with a different working directory, use an absolute path,
# e.g. DATABASE_URL="file:/abs/path/to/eventplus/dev.db"
DATABASE_URL="file:./dev.db"

# Production target (Postgres): swap the datasource provider in
# prisma/schema.prisma to "postgresql" and set, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/eventplus?schema=public"
