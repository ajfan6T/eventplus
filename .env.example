# Copy to .env and adjust. Loaded by prisma.config.ts (via dotenv) and the app.
#
# Dev (SQLite): a local file. A relative path resolves from the project root.
# If your process runs with a different working directory, use an absolute path,
# e.g. DATABASE_URL="file:/abs/path/to/eventplus/dev.db"
DATABASE_URL="file:./dev.db"

# Production target (Postgres): swap the datasource provider in
# prisma/schema.prisma to "postgresql" and set, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/eventplus?schema=public"

# Auth.js (NextAuth v5). Generate a secret: `node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"`
AUTH_SECRET="replace-with-a-random-secret"
# Optional Google OAuth — leave blank to hide the Google sign-in button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend). Leave RESEND_API_KEY blank in dev — emails are logged to the console.
# In prod, set a key and a verified sender domain.
RESEND_API_KEY=""
RESEND_FROM="Eventplus <onboarding@resend.dev>"
